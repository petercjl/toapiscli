    "input": "administrator-provided JSON file",
    "command": "auth import --file",
    "schema": {
      "schemaVersion": 1,
      "site": "cn|com",
      "apiKey": "secret string",
      "label": "optional string"
    },
    "storage": "user-only file outside package; Windows inherits user profile ACL",
    "neverIncludedInPackage": true
  },
  "installationLifecycle": {
    "skillRequired": true,
    "updateRequiresSkillSync": true,
    "required_components": [
      "cli",
      "skill"
    ],
    "install": "INSTALL.md",
    "update": "UPDATE.md",
    "verification": "skill status --target <exact-directory> --json; host verifies discovery",
    "physicalIsolation": true,
    "agentNeutral": true,
    "targetRequired": true,
    "hostRegistrationRequired": true,
    "installationMode": "copy",
    "sharedLinksAllowed": false,
    "isolatedRuntimeRequired": true
  },
  "automaticUpdates": {
    "trigger": "prepare, models list and image generate; selected target-owned runtime",
    "timeoutMs": 1200,
    "cacheHours": 24,
    "optOut": "TOAPISCLI_UPDATE_CHECK=0",
    "automaticInstall": true,
    "installCommand": "update install --target <exact-directory> --yes",
    "scope": "selected Agent runtime and Skill; global bootstrap unchanged",
    "enabledByDefault": true,
    "intervalHours": 24,
    "configuration": "TOAPISCLI_UPDATE_CHECK",
    "disable": "TOAPISCLI_UPDATE_CHECK=0",
    "policyCommand": "update policy --target <exact-directory> --mode auto|off",
    "policyStorage": "outside package, scoped by exact target",
    "compatibility": "stable same major; for 0.x same minor",
    "disableInstall": "TOAPISCLI_AUTO_UPDATE=0",
    "recovery": "Offline/failure uses verified previous runtime; interrupted sync blocks tasks until recovery."
  },
